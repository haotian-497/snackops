# Optional override for JSON data directory. Defaults to <projectRoot>/data
DATA_DIR=

# Optional override for the project root used to resolve data/, skills/, tools/
SNACKOPS_ROOT=

# Dev/start port. Defaults to 5000
DEPLOY_RUN_PORT=5000

# LLM provider: demo | openai-compatible
# 打包演示建议默认 demo；缺真实密钥时不会静默回落。
LLM_PROVIDER=demo
LLM_MODEL=deepseek-v4-flash

# openai-compatible（也可在「模型」页粘贴 Key / Base URL，写入 data/llm-secrets.json）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# 允许 HTTP 一键恢复演示数据（开发环境默认允许；生产需显式设为 1）
# ALLOW_DEMO_RESET=1
